# Example nginx server block that reverse-proxies a public domain to the
# Node process running locally on PORT (see .env.example).
#
# Install (typical Debian/Ubuntu layout):
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/save-the-future-api
#   sudo ln -s /etc/nginx/sites-available/save-the-future-api /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Then issue a free TLS certificate for the domain (replace the placeholder):
#   sudo certbot --nginx -d api.your-domain.example
# certbot rewrites this file to add the https:// server block and redirect
# automatically, so it is fine to run it after this file is in place.

server {
    listen 80;
    server_name api.your-domain.example;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Poster uploads can be a few MB; match the app's own 10MB limit.
        client_max_body_size 12m;
    }
}
