# Copy this file to .env on the server and fill in real values.
# Never commit the real .env file.

# Port the Node process listens on. Nginx (or another reverse proxy) forwards
# public traffic to this local port.
PORT=8787

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# One-time key used to create the first organizer account via POST /api/setup.
# Pick any long random value, use it once, then you can forget it — the
# endpoint refuses to run again once any account exists.
SETUP_KEY=change-me-one-time-key

# Comma-separated list of frontend origins allowed to call this API with
# credentials (cookies), e.g.:
#   ALLOWED_ORIGIN=https://your-domain.example,https://edcafeteacher-art.github.io
ALLOWED_ORIGIN=http://localhost:5173

# Where the SQLite database file and uploaded poster images are stored.
# Defaults to ./data next to this file if left unset.
DATA_DIR=./data
